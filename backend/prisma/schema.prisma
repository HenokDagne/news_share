generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
  AUDITOR
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  SUSPENDED
  BANNED
  DELETED
}

enum Permission {
  DASHBOARD_VIEW
  USERS_VIEW
  USERS_MANAGE
  USERS_BAN
  USERS_DELETE
  REPORTS_VIEW
  REPORTS_MODERATE
  POSTS_REMOVE
  ADMINS_MANAGE
  AUDIT_VIEW
  AUDIT_EXPORT
  BACKUPS_VIEW
  BACKUPS_CREATE
  BACKUPS_RESTORE
  BACKUPS_MANAGE
}

enum RestrictionType {
  DEACTIVATION
  SUSPENSION
  BAN
}

enum RestrictionStatus {
  ACTIVE
  EXPIRED
  LIFTED
}

enum PostStatus {
  ACTIVE
  REMOVED
}

enum ReportTargetType {
  POST
  USER
}

enum ReportReason {
  SEXUAL_CONTENT
  NUDITY
  HARASSMENT_BULLYING
  HATE_SPEECH
  VIOLENCE
  SPAM_SCAM
  MISINFORMATION
  OTHER
}

enum CaseStatus {
  PENDING
  UNDER_REVIEW
  ACTION_TAKEN
  REJECTED
  RESOLVED
}

enum ModerationActionType {
  DISMISS_REPORTS
  REMOVE_POST
  RESTORE_POST
  WARN_USER
  SUSPEND_USER
  BAN_USER
  UNBAN_USER
  DEACTIVATE_USER
  ACTIVATE_USER
  DELETE_USER
  RESTORE_USER
}

enum ActivityType {
  REPORT_SUBMITTED
  REPORT_STATUS_CHANGED
  WARNING_RECEIVED
  RESTRICTION_APPLIED
  RESTRICTION_LIFTED
  POST_REMOVED
  POST_RESTORED
  ACCOUNT_STATUS_CHANGED
  PASSWORD_CHANGED
}

model User {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String            @unique
  passwordHash      String            @map("password_hash")
  role              Role              @default(USER)
  status            UserStatus        @default(ACTIVE)
  statusUpdatedAt   DateTime?         @map("status_updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(6)
  deletedById       String?           @map("deleted_by_id") @db.Uuid
  mustChangePassword Boolean          @default(false) @map("must_change_password")
  lastActiveAt      DateTime?         @map("last_active_at") @db.Timestamptz(6)
  createdById       String?           @map("created_by_id") @db.Uuid
  emailVerified     Boolean           @default(false) @map("email_verified")
  emailVerifiedAt   DateTime?         @map("email_verified_at") @db.Timestamptz(6)
  failedLoginCount  Int               @default(0) @map("failed_login_count")
  lockedUntil       DateTime?         @map("locked_until") @db.Timestamptz(6)
  lastLoginAt       DateTime?         @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?         @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  oneTimeTokens     OneTimeToken[]
  profile           Profile?
  refreshTokens     RefreshToken[]
  sessions          Session[]
  auditLogs         AuditLog[]
  securityAlerts    SecurityAlert[]
  permissions       UserPermission[]
  restrictions      UserRestriction[]
  warnings          UserWarning[]
  activities        UserActivity[]
  notInterested     NotInterested[]
  savedPosts        SavedPost[]
  likes             Like[]
  reportsFiled      Report[]
  casesAgainst      ReportCase[]       @relation("CaseTargetUser")
  actionsAgainst    ModerationAction[] @relation("ActionTargetUser")

  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  ip            String?
  userAgent     String?        @map("user_agent")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActiveAt  DateTime       @default(now()) @map("last_active_at") @db.Timestamptz(6)
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?        @map("revoked_reason")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model OneTimeToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      TokenType
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("one_time_tokens")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String?   @map("session_id") @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  session   Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@map("refresh_tokens")
}

model Profile {
  id                 String         @id @db.Uuid
  username           String         @unique
  fullName           String?        @map("full_name")
  bio                String?
  avatarUrl          String?        @map("avatar_url")
  avatarPublicId     String?        @map("avatar_public_id")
  followersCount     Int            @default(0) @map("followers_count")
  followingCount     Int            @default(0) @map("following_count")
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  following          Follow[]       @relation("Follower")
  followers          Follow[]       @relation("Following")
  actedNotifications Notification[] @relation("Actor")
  notifications      Notification[] @relation("Recipient")
  posts              Post[]
  comments           Comment[]
  user               User           @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Post {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  title             String?
  content           String?
  imageUrl          String?         @map("image_url")
  imagePublicId     String?         @map("image_public_id")
  imageResourceType String          @default("image") @map("image_resource_type")
  status            PostStatus      @default(ACTIVE)
  removedAt         DateTime?       @map("removed_at") @db.Timestamptz(6)
  removedById       String?         @map("removed_by_id") @db.Uuid
  removalReason     String?         @map("removal_reason")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  notifications     Notification[]
  author            Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notInterestedBy   NotInterested[]
  savedBy           SavedPost[]
  likes             Like[]
  comments          Comment[]
  cases             ReportCase[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("posts")
}

model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  follower    Profile  @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   Profile  @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt(sort: Desc)])
  @@map("followers")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  type      String
  postId    String?  @map("post_id") @db.Uuid
  message   String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor     Profile? @relation("Actor", fields: [actorId], references: [id])
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipient Profile  @relation("Recipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("notifications")
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum AuditCategory {
  USER_ACTIVITY
  AUTHENTICATION
  AUTHORIZATION
  DATA_CHANGE
  SENSITIVE_RESOURCE
  ADMIN_ACTION
  SYSTEM_EVENT
  SECURITY_ALERT
}

enum AuditSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model AuditLog {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequenceNumber BigInt        @unique @default(autoincrement()) @map("sequence_number")
  timestamp      DateTime      @default(now()) @map("timestamp") @db.Timestamptz(6)
  category       AuditCategory @default(USER_ACTIVITY)
  action         String
  severity       AuditSeverity @default(INFO)
  userId         String?       @map("user_id") @db.Uuid
  username       String?
  ipAddress      String?       @map("ip_address")
  userAgent      String?       @map("user_agent")
  resource       String?
  httpMethod     String?       @map("http_method")
  statusCode     Int?          @map("status_code")
  durationMs     Int?          @map("duration_ms")
  encryptedData  String?       @map("encrypted_data") @db.Text
  dataHash       String?       @map("data_hash")
  previousHash   String        @map("previous_hash")
  recordHash     String        @map("record_hash")
  isExported     Boolean       @default(false) @map("is_exported")
  exportedAt     DateTime?     @map("exported_at") @db.Timestamptz(6)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([timestamp(sort: Desc)])
  @@index([action])
  @@index([userId])
  @@index([category])
  @@index([severity])
  @@index([ipAddress])
  @@map("audit_logs")
}

model SecurityAlert {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp        DateTime      @default(now()) @map("timestamp") @db.Timestamptz(6)
  alertType        String        @map("alert_type")
  severity         AuditSeverity @default(HIGH)
  status           AlertStatus   @default(OPEN)
  title            String
  description      String
  ipAddress        String?       @map("ip_address")
  userId           String?       @map("user_id") @db.Uuid
  username         String?
  metadata         Json?
  escalationTier   String        @default("TIER_1") @map("escalation_tier")
  routedTo         String?       @map("routed_to")
  notificationSent Boolean       @default(false) @map("notification_sent")
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz(6)
  resolvedBy       String?       @map("resolved_by")
  resolutionNotes  String?       @map("resolution_notes")
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([severity])
  @@index([alertType])
  @@index([timestamp(sort: Desc)])
  @@map("security_alerts")
}

model AuditPurgeLog {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp            DateTime  @default(now()) @map("timestamp") @db.Timestamptz(6)
  retentionDays        Int       @map("retention_days")
  recordsPurged        Int       @map("records_purged")
  oldestRecordPurgedAt DateTime? @map("oldest_record_purged_at") @db.Timestamptz(6)
  newestRecordPurgedAt DateTime? @map("newest_record_purged_at") @db.Timestamptz(6)
  genesisRecordHash    String    @map("genesis_record_hash")
  purgedBy             String?   @map("purged_by")

  @@map("audit_purge_logs")
}

model UserPermission {
  userId      String     @map("user_id") @db.Uuid
  permission  Permission
  grantedById String?    @map("granted_by_id") @db.Uuid
  grantedAt   DateTime   @default(now()) @map("granted_at") @db.Timestamptz(6)

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@map("user_permissions")
}

model UserRestriction {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  type          RestrictionType
  status        RestrictionStatus @default(ACTIVE)
  reason        String
  publicReason  String?           @map("public_reason")
  evidenceRef   String?           @map("evidence_ref")
  policyRef     String?           @map("policy_ref")
  imposedById   String            @map("imposed_by_id") @db.Uuid
  caseId        String?           @map("case_id") @db.Uuid
  startsAt      DateTime          @default(now()) @map("starts_at") @db.Timestamptz(6)
  expiresAt     DateTime?         @map("expires_at") @db.Timestamptz(6)
  liftedAt      DateTime?         @map("lifted_at") @db.Timestamptz(6)
  liftedById    String?           @map("lifted_by_id") @db.Uuid
  liftReason    String?           @map("lift_reason")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("user_restrictions")
}

model UserWarning {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  issuedById String    @map("issued_by_id") @db.Uuid
  caseId     String?   @map("case_id") @db.Uuid
  message    String
  policyRef  String?   @map("policy_ref")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)

  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@map("user_warnings")
}

model ReportCase {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetKey       String             @map("target_key")
  targetType      ReportTargetType   @map("target_type")
  targetPostId    String?            @map("target_post_id") @db.Uuid
  targetUserId    String             @map("target_user_id") @db.Uuid
  status          CaseStatus         @default(PENDING)
  priorityScore   Int                @default(0) @map("priority_score")
  reportCount     Int                @default(0) @map("report_count")
  topReason       ReportReason?      @map("top_reason")
  snapshot        Json
  assignedToId    String?            @map("assigned_to_id") @db.Uuid
  firstReportedAt DateTime           @map("first_reported_at") @db.Timestamptz(6)
  lastReportedAt  DateTime           @map("last_reported_at") @db.Timestamptz(6)
  closedAt        DateTime?          @map("closed_at") @db.Timestamptz(6)
  closedById      String?            @map("closed_by_id") @db.Uuid
  outcomeNote     String?            @map("outcome_note")

  targetUser      User               @relation("CaseTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  targetPost      Post?              @relation(fields: [targetPostId], references: [id], onDelete: SetNull)
  reports         Report[]
  actions         ModerationAction[]

  @@index([status, priorityScore(sort: Desc), lastReportedAt(sort: Desc)])
  @@index([targetKey, status])
  @@index([targetUserId])
  @@map("report_cases")
}

model Report {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId     String       @map("case_id") @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  targetKey  String       @map("target_key")
  reason     ReportReason
  details    String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  case       ReportCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Restrict)

  @@unique([caseId, reporterId])
  @@index([reporterId, targetKey, createdAt(sort: Desc)])
  @@map("reports")
}

model ModerationAction {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          ModerationActionType
  caseId        String?              @map("case_id") @db.Uuid
  targetUserId  String               @map("target_user_id") @db.Uuid
  targetPostId  String?              @map("target_post_id") @db.Uuid
  performedById String               @map("performed_by_id") @db.Uuid
  reason        String
  publicReason  String?              @map("public_reason")
  evidenceRef   String?              @map("evidence_ref")
  policyRef     String?              @map("policy_ref")
  restrictionId String?              @map("restriction_id") @db.Uuid
  expiresAt     DateTime?            @map("expires_at") @db.Timestamptz(6)
  metadata      Json?
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  case          ReportCase?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  targetUser    User                 @relation("ActionTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([performedById, createdAt(sort: Desc)])
  @@index([caseId])
  @@map("moderation_actions")
}

model NotInterested {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("not_interested")
}

model SavedPost {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_posts")
}

model Like {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("likes")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt(sort: Asc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("comments")
}

model UserActivity {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      ActivityType
  title     String
  body      String?
  refType   String?      @map("ref_type")
  refId     String?      @map("ref_id") @db.Uuid
  metadata  Json?
  isRead    Boolean      @default(false) @map("is_read")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("user_activities")
}

enum BackupType {
  FULL
  INCREMENTAL
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  DISPOSED
}

enum RestoreTestStatus {
  IN_PROGRESS
  SUCCESS
  FAILED
}

model BackupArchive {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  backupType              BackupType            @default(FULL) @map("backup_type")
  status                  BackupStatus          @default(PENDING)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt             DateTime?             @map("completed_at") @db.Timestamptz(6)
  rpoTargetMinutes        Int                   @default(1440) @map("rpo_target_minutes")
  rtoTargetMinutes        Int                   @default(15) @map("rto_target_minutes")
  uncompressedSizeBytes   BigInt                @default(0) @map("uncompressed_size_bytes")
  compressedSizeBytes     BigInt                @default(0) @map("compressed_size_bytes")
  checksumSha256          String                @map("checksum_sha256")
  encryptedChecksumSha256 String                @map("encrypted_checksum_sha256")
  encryptionAlgorithm     String                @default("AES-256-GCM") @map("encryption_algorithm")
  encryptionKeyId         String                @default("master-backup-key-v1") @map("encryption_key_id")
  iv                      String
  authTag                 String                @map("auth_tag")
  manifest                Json
  parentBackupId          String?               @map("parent_backup_id") @db.Uuid
  copiesCount             Int                   @default(3) @map("copies_count")
  mediaTypesCount         Int                   @default(2) @map("media_types_count")
  hasOffsiteCopy          Boolean               @default(true) @map("has_offsite_copy")
  primaryLocation         String                @map("primary_location")
  secondaryLocation       String?               @map("secondary_location")
  offsiteLocation         String?               @map("offsite_location")
  isImmutable             Boolean               @default(true) @map("is_immutable")
  retentionLockUntil      DateTime              @map("retention_lock_until") @db.Timestamptz(6)
  legalHold               Boolean               @default(false) @map("legal_hold")
  createdBy               String?               @map("created_by")
  createdIp               String?               @map("created_ip")
  restoreTests            BackupRestoreTest[]
  disposalRecord          BackupDisposalRecord?

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([backupType])
  @@map("backup_archives")
}

model BackupRestoreTest {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  backupId            String            @map("backup_id") @db.Uuid
  testType            String            @default("AUTOMATED_PERIODIC") @map("test_type")
  status              RestoreTestStatus @default(IN_PROGRESS)
  startedAt           DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(6)
  durationMs          Int?              @map("duration_ms")
  targetRtoSeconds    Int               @default(900) @map("target_rto_seconds")
  actualRtoSeconds    Int?              @map("actual_rto_seconds")
  integrityVerified   Boolean           @default(false) @map("integrity_verified")
  decryptionVerified  Boolean           @default(false) @map("decryption_verified")
  schemaVerified      Boolean           @default(false) @map("schema_verified")
  dataRowsVerified    Int               @default(0) @map("data_rows_verified")
  tablesVerified      Json?             @map("tables_verified")
  errorMessage        String?           @map("error_message")
  testedBy            String?           @map("tested_by")
  testEnvironment     String            @default("ISOLATED_SANDBOX") @map("test_environment")
  backup              BackupArchive     @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@index([backupId])
  @@index([startedAt(sort: Desc)])
  @@map("backup_restore_tests")
}

model BackupDisposalRecord {
  id                            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  backupId                      String        @unique @map("backup_id") @db.Uuid
  disposedAt                    DateTime      @default(now()) @map("disposed_at") @db.Timestamptz(6)
  disposedBy                    String        @map("disposed_by")
  reason                        String
  wipeAlgorithm                 String        @default("NIST_SP_800_88_REV1_OVERWRITE") @map("wipe_algorithm")
  overwritePasses               Int           @default(3) @map("overwrite_passes")
  cryptographicErasureConfirmed Boolean       @default(true) @map("cryptographic_erasure_confirmed")
  certificateOfDestruction      Json          @map("certificate_of_destruction")
  auditLogId                    String?       @map("audit_log_id")
  backup                        BackupArchive @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@map("backup_disposal_records")
}
