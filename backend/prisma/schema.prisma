generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
  AUDITOR
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  SUSPENDED
  BANNED
  DELETED
}

enum Permission {
  DASHBOARD_VIEW
  USERS_VIEW
  USERS_MANAGE
  USERS_BAN
  USERS_DELETE
  REPORTS_VIEW
  REPORTS_MODERATE
  POSTS_REMOVE
  ADMINS_MANAGE
  AUDIT_VIEW
  AUDIT_EXPORT
  BACKUPS_VIEW
  BACKUPS_CREATE
  BACKUPS_RESTORE
  BACKUPS_MANAGE
  ROLES_VIEW
  ROLES_MANAGE
  ACCESS_REVIEWS_MANAGE
  COMPLIANCE_VIEW
  COMPLIANCE_MANAGE
  PRIVACY_MANAGE
  INCIDENTS_MANAGE
  CHANGES_MANAGE
}

enum RestrictionType {
  DEACTIVATION
  SUSPENSION
  BAN
}

enum RestrictionStatus {
  ACTIVE
  EXPIRED
  LIFTED
}

enum PostStatus {
  ACTIVE
  REMOVED
}

enum ReportTargetType {
  POST
  USER
}

enum ReportReason {
  SEXUAL_CONTENT
  NUDITY
  HARASSMENT_BULLYING
  HATE_SPEECH
  VIOLENCE
  SPAM_SCAM
  MISINFORMATION
  OTHER
}

enum CaseStatus {
  PENDING
  UNDER_REVIEW
  ACTION_TAKEN
  REJECTED
  RESOLVED
}

enum ModerationActionType {
  DISMISS_REPORTS
  REMOVE_POST
  RESTORE_POST
  WARN_USER
  SUSPEND_USER
  BAN_USER
  UNBAN_USER
  DEACTIVATE_USER
  ACTIVATE_USER
  DELETE_USER
  RESTORE_USER
}

enum ActivityType {
  REPORT_SUBMITTED
  REPORT_STATUS_CHANGED
  WARNING_RECEIVED
  RESTRICTION_APPLIED
  RESTRICTION_LIFTED
  POST_REMOVED
  POST_RESTORED
  ACCOUNT_STATUS_CHANGED
  PASSWORD_CHANGED
}

model User {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String            @unique
  passwordHash      String            @map("password_hash")
  role              Role              @default(USER)
  status            UserStatus        @default(ACTIVE)
  statusUpdatedAt   DateTime?         @map("status_updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(6)
  deletedById       String?           @map("deleted_by_id") @db.Uuid
  mustChangePassword Boolean          @default(false) @map("must_change_password")
  lastActiveAt      DateTime?         @map("last_active_at") @db.Timestamptz(6)
  createdById       String?           @map("created_by_id") @db.Uuid
  emailVerified     Boolean           @default(false) @map("email_verified")
  emailVerifiedAt   DateTime?         @map("email_verified_at") @db.Timestamptz(6)
  failedLoginCount  Int               @default(0) @map("failed_login_count")
  lockedUntil       DateTime?         @map("locked_until") @db.Timestamptz(6)
  lastLoginAt       DateTime?         @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?         @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  oneTimeTokens     OneTimeToken[]
  profile           Profile?
  refreshTokens     RefreshToken[]
  sessions          Session[]
  auditLogs         AuditLog[]
  securityAlerts    SecurityAlert[]
  permissions       UserPermission[]
  restrictions      UserRestriction[]
  warnings          UserWarning[]
  activities        UserActivity[]
  notInterested     NotInterested[]
  savedPosts        SavedPost[]
  likes             Like[]
  reportsFiled      Report[]
  casesAgainst      ReportCase[]           @relation("CaseTargetUser")
  actionsAgainst    ModerationAction[]     @relation("ActionTargetUser")
  roleRequestsRequested RoleChangeRequest[] @relation("RoleRequestRequester")
  roleRequestsTargeted  RoleChangeRequest[] @relation("RoleRequestTarget")
  roleRequestsReviewed  RoleChangeRequest[] @relation("RoleRequestReviewer")
  reviewCampaignsConducted AccessReviewCampaign[] @relation("CampaignConductor")
  reviewDecisionsReceived  AccessReviewDecision[] @relation("ReviewDecisionUser")
  reviewDecisionsConducted AccessReviewDecision[] @relation("ReviewDecisionReviewer")
  legalObligationsCreated LegalObligation[] @relation("ObligationCreator")
  securityPoliciesAuthored SecurityPolicy[] @relation("PolicyAuthor")
  policyVersionsApproved PolicyVersion[] @relation("PolicyVersionApprover")
  privacyRequests PrivacyRequest[] @relation("UserPrivacyRequests")
  privacyRequestsResolved PrivacyRequest[] @relation("PrivacyRequestResolver")
  consents ConsentRecord[] @relation("UserConsents")
  dataBreachesRecorded DataBreachRecord[] @relation("BreachRecorder")
  securityFindingsAssigned SecurityFinding[] @relation("FindingAssignee")
  risksOwned RiskRegister[] @relation("RiskOwner")
  incidentsLed SecurityIncident[] @relation("IncidentLead")
  changeRequestsMade ChangeRequest[] @relation("ChangeRequester")
  changeRequestsApproved ChangeRequest[] @relation("ChangeApprover")
  blockedUsers UserBlock[] @relation("BlockerUsers")
  blockedByUsers UserBlock[] @relation("BlockedUsers")

  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  ip            String?
  userAgent     String?        @map("user_agent")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActiveAt  DateTime       @default(now()) @map("last_active_at") @db.Timestamptz(6)
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?        @map("revoked_reason")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model OneTimeToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      TokenType
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("one_time_tokens")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String?   @map("session_id") @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  session   Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@map("refresh_tokens")
}

model Profile {
  id                 String         @id @db.Uuid
  username           String         @unique
  fullName           String?        @map("full_name")
  bio                String?
  avatarUrl          String?        @map("avatar_url")
  avatarPublicId     String?        @map("avatar_public_id")
  followersCount     Int            @default(0) @map("followers_count")
  followingCount     Int            @default(0) @map("following_count")
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  following          Follow[]       @relation("Follower")
  followers          Follow[]       @relation("Following")
  actedNotifications Notification[] @relation("Actor")
  notifications      Notification[] @relation("Recipient")
  posts              Post[]
  comments           Comment[]
  user               User           @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Post {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  title             String?
  content           String?
  imageUrl          String?         @map("image_url")
  imagePublicId     String?         @map("image_public_id")
  imageResourceType String          @default("image") @map("image_resource_type")
  status            PostStatus      @default(ACTIVE)
  removedAt         DateTime?       @map("removed_at") @db.Timestamptz(6)
  removedById       String?         @map("removed_by_id") @db.Uuid
  removalReason     String?         @map("removal_reason")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  notifications     Notification[]
  author            Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notInterestedBy   NotInterested[]
  savedBy           SavedPost[]
  likes             Like[]
  comments          Comment[]
  cases             ReportCase[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("posts")
}

model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  follower    Profile  @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   Profile  @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt(sort: Desc)])
  @@map("followers")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  type      String
  postId    String?  @map("post_id") @db.Uuid
  message   String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor     Profile? @relation("Actor", fields: [actorId], references: [id])
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipient Profile  @relation("Recipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("notifications")
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum AuditCategory {
  USER_ACTIVITY
  AUTHENTICATION
  AUTHORIZATION
  DATA_CHANGE
  SENSITIVE_RESOURCE
  ADMIN_ACTION
  SYSTEM_EVENT
  SECURITY_ALERT
}

enum AuditSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model AuditLog {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequenceNumber BigInt        @unique @default(autoincrement()) @map("sequence_number")
  timestamp      DateTime      @default(now()) @map("timestamp") @db.Timestamptz(6)
  category       AuditCategory @default(USER_ACTIVITY)
  action         String
  severity       AuditSeverity @default(INFO)
  userId         String?       @map("user_id") @db.Uuid
  username       String?
  ipAddress      String?       @map("ip_address")
  userAgent      String?       @map("user_agent")
  resource       String?
  httpMethod     String?       @map("http_method")
  statusCode     Int?          @map("status_code")
  durationMs     Int?          @map("duration_ms")
  encryptedData  String?       @map("encrypted_data") @db.Text
  dataHash       String?       @map("data_hash")
  previousHash   String        @map("previous_hash")
  recordHash     String        @map("record_hash")
  isExported     Boolean       @default(false) @map("is_exported")
  exportedAt     DateTime?     @map("exported_at") @db.Timestamptz(6)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([timestamp(sort: Desc)])
  @@index([action])
  @@index([userId])
  @@index([category])
  @@index([severity])
  @@index([ipAddress])
  @@map("audit_logs")
}

model SecurityAlert {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp        DateTime      @default(now()) @map("timestamp") @db.Timestamptz(6)
  alertType        String        @map("alert_type")
  severity         AuditSeverity @default(HIGH)
  status           AlertStatus   @default(OPEN)
  title            String
  description      String
  ipAddress        String?       @map("ip_address")
  userId           String?       @map("user_id") @db.Uuid
  username         String?
  metadata         Json?
  escalationTier   String        @default("TIER_1") @map("escalation_tier")
  routedTo         String?       @map("routed_to")
  notificationSent Boolean       @default(false) @map("notification_sent")
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz(6)
  resolvedBy       String?       @map("resolved_by")
  resolutionNotes  String?       @map("resolution_notes")
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([severity])
  @@index([alertType])
  @@index([timestamp(sort: Desc)])
  @@map("security_alerts")
}

model AuditPurgeLog {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp            DateTime  @default(now()) @map("timestamp") @db.Timestamptz(6)
  retentionDays        Int       @map("retention_days")
  recordsPurged        Int       @map("records_purged")
  oldestRecordPurgedAt DateTime? @map("oldest_record_purged_at") @db.Timestamptz(6)
  newestRecordPurgedAt DateTime? @map("newest_record_purged_at") @db.Timestamptz(6)
  genesisRecordHash    String    @map("genesis_record_hash")
  purgedBy             String?   @map("purged_by")

  @@map("audit_purge_logs")
}

model UserPermission {
  userId      String     @map("user_id") @db.Uuid
  permission  Permission
  grantedById String?    @map("granted_by_id") @db.Uuid
  grantedAt   DateTime   @default(now()) @map("granted_at") @db.Timestamptz(6)

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@map("user_permissions")
}

model UserRestriction {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  type          RestrictionType
  status        RestrictionStatus @default(ACTIVE)
  reason        String
  publicReason  String?           @map("public_reason")
  evidenceRef   String?           @map("evidence_ref")
  policyRef     String?           @map("policy_ref")
  imposedById   String            @map("imposed_by_id") @db.Uuid
  caseId        String?           @map("case_id") @db.Uuid
  startsAt      DateTime          @default(now()) @map("starts_at") @db.Timestamptz(6)
  expiresAt     DateTime?         @map("expires_at") @db.Timestamptz(6)
  liftedAt      DateTime?         @map("lifted_at") @db.Timestamptz(6)
  liftedById    String?           @map("lifted_by_id") @db.Uuid
  liftReason    String?           @map("lift_reason")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("user_restrictions")
}

model UserWarning {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  issuedById String    @map("issued_by_id") @db.Uuid
  caseId     String?   @map("case_id") @db.Uuid
  message    String
  policyRef  String?   @map("policy_ref")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)

  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@map("user_warnings")
}

model ReportCase {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetKey       String             @map("target_key")
  targetType      ReportTargetType   @map("target_type")
  targetPostId    String?            @map("target_post_id") @db.Uuid
  targetUserId    String             @map("target_user_id") @db.Uuid
  status          CaseStatus         @default(PENDING)
  priorityScore   Int                @default(0) @map("priority_score")
  reportCount     Int                @default(0) @map("report_count")
  topReason       ReportReason?      @map("top_reason")
  snapshot        Json
  assignedToId    String?            @map("assigned_to_id") @db.Uuid
  firstReportedAt DateTime           @map("first_reported_at") @db.Timestamptz(6)
  lastReportedAt  DateTime           @map("last_reported_at") @db.Timestamptz(6)
  closedAt        DateTime?          @map("closed_at") @db.Timestamptz(6)
  closedById      String?            @map("closed_by_id") @db.Uuid
  outcomeNote     String?            @map("outcome_note")

  targetUser      User               @relation("CaseTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  targetPost      Post?              @relation(fields: [targetPostId], references: [id], onDelete: SetNull)
  reports         Report[]
  actions         ModerationAction[]

  @@index([status, priorityScore(sort: Desc), lastReportedAt(sort: Desc)])
  @@index([targetKey, status])
  @@index([targetUserId])
  @@map("report_cases")
}

model Report {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId     String       @map("case_id") @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  targetKey  String       @map("target_key")
  reason     ReportReason
  details    String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  case       ReportCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Restrict)

  @@unique([caseId, reporterId])
  @@index([reporterId, targetKey, createdAt(sort: Desc)])
  @@map("reports")
}

model ModerationAction {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          ModerationActionType
  caseId        String?              @map("case_id") @db.Uuid
  targetUserId  String               @map("target_user_id") @db.Uuid
  targetPostId  String?              @map("target_post_id") @db.Uuid
  performedById String               @map("performed_by_id") @db.Uuid
  reason        String
  publicReason  String?              @map("public_reason")
  evidenceRef   String?              @map("evidence_ref")
  policyRef     String?              @map("policy_ref")
  restrictionId String?              @map("restriction_id") @db.Uuid
  expiresAt     DateTime?            @map("expires_at") @db.Timestamptz(6)
  metadata      Json?
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  case          ReportCase?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  targetUser    User                 @relation("ActionTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([performedById, createdAt(sort: Desc)])
  @@index([caseId])
  @@map("moderation_actions")
}

model NotInterested {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("not_interested")
}

model SavedPost {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_posts")
}

model Like {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("likes")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt(sort: Asc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("comments")
}

model UserActivity {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      ActivityType
  title     String
  body      String?
  refType   String?      @map("ref_type")
  refId     String?      @map("ref_id") @db.Uuid
  metadata  Json?
  isRead    Boolean      @default(false) @map("is_read")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("user_activities")
}

enum BackupType {
  FULL
  INCREMENTAL
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  DISPOSED
}

enum RestoreTestStatus {
  IN_PROGRESS
  SUCCESS
  FAILED
}

model BackupArchive {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  backupType              BackupType            @default(FULL) @map("backup_type")
  status                  BackupStatus          @default(PENDING)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt             DateTime?             @map("completed_at") @db.Timestamptz(6)
  rpoTargetMinutes        Int                   @default(1440) @map("rpo_target_minutes")
  rtoTargetMinutes        Int                   @default(15) @map("rto_target_minutes")
  uncompressedSizeBytes   BigInt                @default(0) @map("uncompressed_size_bytes")
  compressedSizeBytes     BigInt                @default(0) @map("compressed_size_bytes")
  checksumSha256          String                @map("checksum_sha256")
  encryptedChecksumSha256 String                @map("encrypted_checksum_sha256")
  encryptionAlgorithm     String                @default("AES-256-GCM") @map("encryption_algorithm")
  encryptionKeyId         String                @default("master-backup-key-v1") @map("encryption_key_id")
  iv                      String
  authTag                 String                @map("auth_tag")
  manifest                Json
  parentBackupId          String?               @map("parent_backup_id") @db.Uuid
  copiesCount             Int                   @default(3) @map("copies_count")
  mediaTypesCount         Int                   @default(2) @map("media_types_count")
  hasOffsiteCopy          Boolean               @default(true) @map("has_offsite_copy")
  primaryLocation         String                @map("primary_location")
  secondaryLocation       String?               @map("secondary_location")
  offsiteLocation         String?               @map("offsite_location")
  isImmutable             Boolean               @default(true) @map("is_immutable")
  retentionLockUntil      DateTime              @map("retention_lock_until") @db.Timestamptz(6)
  legalHold               Boolean               @default(false) @map("legal_hold")
  createdBy               String?               @map("created_by")
  createdIp               String?               @map("created_ip")
  restoreTests            BackupRestoreTest[]
  disposalRecord          BackupDisposalRecord?

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([backupType])
  @@map("backup_archives")
}

model BackupRestoreTest {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  backupId            String            @map("backup_id") @db.Uuid
  testType            String            @default("AUTOMATED_PERIODIC") @map("test_type")
  status              RestoreTestStatus @default(IN_PROGRESS)
  startedAt           DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(6)
  durationMs          Int?              @map("duration_ms")
  targetRtoSeconds    Int               @default(900) @map("target_rto_seconds")
  actualRtoSeconds    Int?              @map("actual_rto_seconds")
  integrityVerified   Boolean           @default(false) @map("integrity_verified")
  decryptionVerified  Boolean           @default(false) @map("decryption_verified")
  schemaVerified      Boolean           @default(false) @map("schema_verified")
  dataRowsVerified    Int               @default(0) @map("data_rows_verified")
  tablesVerified      Json?             @map("tables_verified")
  errorMessage        String?           @map("error_message")
  testedBy            String?           @map("tested_by")
  testEnvironment     String            @default("ISOLATED_SANDBOX") @map("test_environment")
  backup              BackupArchive     @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@index([backupId])
  @@index([startedAt(sort: Desc)])
  @@map("backup_restore_tests")
}

model BackupDisposalRecord {
  id                            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  backupId                      String        @unique @map("backup_id") @db.Uuid
  disposedAt                    DateTime      @default(now()) @map("disposed_at") @db.Timestamptz(6)
  disposedBy                    String        @map("disposed_by")
  reason                        String
  wipeAlgorithm                 String        @default("NIST_SP_800_88_REV1_OVERWRITE") @map("wipe_algorithm")
  overwritePasses               Int           @default(3) @map("overwrite_passes")
  cryptographicErasureConfirmed Boolean       @default(true) @map("cryptographic_erasure_confirmed")
  certificateOfDestruction      Json          @map("certificate_of_destruction")
  auditLogId                    String?       @map("audit_log_id")
  backup                        BackupArchive @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@map("backup_disposal_records")
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReviewCampaignStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AccessReviewAction {
  MAINTAIN
  REVOKE
  MODIFY
}

model RoleChangeRequest {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  targetUserId  String            @map("target_user_id") @db.Uuid
  currentRole   Role              @map("current_role")
  requestedRole Role              @map("requested_role")
  justification String
  status        RoleRequestStatus @default(PENDING)
  reviewedById  String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes   String?           @map("review_notes")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  requester     User              @relation("RoleRequestRequester", fields: [userId], references: [id], onDelete: Cascade)
  targetUser    User              @relation("RoleRequestTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  reviewer      User?             @relation("RoleRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@index([targetUserId])
  @@index([createdAt(sort: Desc)])
  @@map("role_change_requests")
}

model AccessReviewCampaign {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  quarter       String
  year          Int
  status        ReviewCampaignStatus @default(IN_PROGRESS)
  startedAt     DateTime             @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?            @map("completed_at") @db.Timestamptz(6)
  conductedById String               @map("conducted_by_id") @db.Uuid
  notes         String?
  decisions     AccessReviewDecision[]

  conductedBy   User                 @relation("CampaignConductor", fields: [conductedById], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([quarter, year])
  @@map("access_review_campaigns")
}

model AccessReviewDecision {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId          String             @map("campaign_id") @db.Uuid
  userId              String             @map("user_id") @db.Uuid
  roleAtReview        Role               @map("role_at_review")
  permissionsAtReview Json               @map("permissions_at_review")
  lastActiveAt        DateTime?          @map("last_active_at") @db.Timestamptz(6)
  decision            AccessReviewAction @default(MAINTAIN)
  decisionReason      String             @map("decision_reason")
  executedAt          DateTime?          @map("executed_at") @db.Timestamptz(6)
  reviewedById        String             @map("reviewed_by_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  campaign            AccessReviewCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user                User               @relation("ReviewDecisionUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy          User               @relation("ReviewDecisionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([userId])
  @@map("access_review_decisions")
}

// ===================== COMPLIANCE & GOVERNANCE ENUMS =====================

enum ComplianceStatus {
  COMPLIANT
  PARTIALLY_COMPLIANT
  NON_COMPLIANT
  UNDER_REVIEW
}

enum PolicyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PrivacyRequestType {
  DATA_ACCESS_EXPORT
  DATA_CORRECTION
  ACCOUNT_DELETION
  RESTRICT_PROCESSING
}

enum PrivacyRequestStatus {
  PENDING
  UNDER_REVIEW
  COMPLETED
  REJECTED
}

enum RiskLikelihood {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum RiskImpact {
  INSIGNIFICANT
  MINOR
  MODERATE
  MAJOR
  CRITICAL
}

enum RiskStatus {
  IDENTIFIED
  ASSESSING
  MITIGATING
  ACCEPTED
  RESOLVED
}

enum IncidentSeverity {
  P1_CRITICAL
  P2_HIGH
  P3_MEDIUM
  P4_LOW
}

enum IncidentStatus {
  REPORTED
  INVESTIGATING
  CONTAINED
  RESOLVED
  POST_MORTEM
}

enum ChangeRiskLevel {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum ChangeRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  IMPLEMENTED
  ROLLED_BACK
}

// ===================== COMPLIANCE & GOVERNANCE MODELS =====================

model LegalObligation {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String
  regulation        String           // e.g., "Ethiopian Proclamation No. 1321/2024"
  jurisdiction      String           @default("Ethiopia")
  description       String
  complianceStatus  ComplianceStatus @default(UNDER_REVIEW) @map("compliance_status")
  responsiblePerson String           @map("responsible_person")
  reviewCycleMonths Int              @default(12) @map("review_cycle_months")
  lastReviewedAt    DateTime?        @map("last_reviewed_at") @db.Timestamptz(6)
  nextReviewAt      DateTime         @map("next_review_at") @db.Timestamptz(6)
  evidenceNotes     String?          @map("evidence_notes")
  createdById       String           @map("created_by_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy         User             @relation("ObligationCreator", fields: [createdById], references: [id])

  @@index([complianceStatus])
  @@index([nextReviewAt])
  @@map("legal_obligations")
}

model SecurityPolicy {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  code           String          @unique // e.g., "POL-SEC-001", "POL-AUP-001"
  category       String          // Acceptable Use, Access Control, Data Retention, etc.
  status         PolicyStatus    @default(DRAFT)
  currentVersion String          @default("1.0.0") @map("current_version")
  summary        String
  content        String          @db.Text
  publishedAt    DateTime?       @map("published_at") @db.Timestamptz(6)
  nextReviewDate DateTime        @map("next_review_date") @db.Timestamptz(6)
  authorId       String          @map("author_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  author         User            @relation("PolicyAuthor", fields: [authorId], references: [id])
  versions       PolicyVersion[]

  @@index([status])
  @@map("security_policies")
}

model PolicyVersion {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId      String         @map("policy_id") @db.Uuid
  versionNumber String         @map("version_number")
  content       String         @db.Text
  changeSummary String         @map("change_summary")
  approvedById  String?        @map("approved_by_id") @db.Uuid
  publishedAt   DateTime       @default(now()) @map("published_at") @db.Timestamptz(6)

  policy        SecurityPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  approvedBy    User?          @relation("PolicyVersionApprover", fields: [approvedById], references: [id])

  @@unique([policyId, versionNumber])
  @@map("policy_versions")
}

model PrivacyRequest {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  requestType     PrivacyRequestType   @map("request_type")
  status          PrivacyRequestStatus @default(PENDING)
  details         String?
  rejectionReason String?              @map("rejection_reason")
  exportFileUrl   String?              @map("export_file_url")
  resolvedById    String?              @map("resolved_by_id") @db.Uuid
  resolvedAt      DateTime?            @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User                 @relation("UserPrivacyRequests", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy      User?                @relation("PrivacyRequestResolver", fields: [resolvedById], references: [id])

  @@index([userId])
  @@index([status])
  @@map("privacy_requests")
}

model ConsentRecord {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  consentType   String    @map("consent_type") // e.g., "TERMS_OF_SERVICE", "ANALYTICS_DATA"
  isGranted     Boolean   @default(true) @map("is_granted")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  policyVersion String?   @map("policy_version")
  grantedAt     DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)

  user          User      @relation("UserConsents", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
  @@map("consent_records")
}

model DataBreachRecord {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String
  incidentRef         String?          @map("incident_ref")
  severity            IncidentSeverity @default(P2_HIGH)
  dataCategories      String[]         @map("data_categories") // e.g. ["EMAILS", "PASSWORDS"]
  estimatedUsersHit   Int              @default(0) @map("estimated_users_hit")
  detectedAt          DateTime         @map("detected_at") @db.Timestamptz(6)
  containedAt         DateTime?        @map("contained_at") @db.Timestamptz(6)
  authorityNotified   Boolean          @default(false) @map("authority_notified")
  authorityNotifiedAt DateTime?        @map("authority_notified_at") @db.Timestamptz(6)
  usersNotified       Boolean          @default(false) @map("users_notified")
  remediationSummary  String           @map("remediation_summary")
  recordedById        String           @map("recorded_by_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  recordedBy          User             @relation("BreachRecorder", fields: [recordedById], references: [id])

  @@map("data_breach_records")
}

model SecurityReview {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  reviewType      String            // e.g. "ACCESS_CONTROL_AUDIT", "VULNERABILITY_ASSESSMENT"
  scope           String
  leadAuditor     String            @map("lead_auditor")
  scheduledDate   DateTime          @map("scheduled_date") @db.Timestamptz(6)
  completedDate   DateTime?         @map("completed_date") @db.Timestamptz(6)
  summaryFindings String?           @map("summary_findings")
  findingsCount   Int               @default(0) @map("findings_count")
  status          CaseStatus        @default(PENDING)
  findings        SecurityFinding[]

  @@map("security_reviews")
}

model SecurityFinding {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId        String         @map("review_id") @db.Uuid
  title           String
  severity        AuditSeverity  @default(MEDIUM)
  description     String
  remediationPlan String         @map("remediation_plan")
  assignedToId    String         @map("assigned_to_id") @db.Uuid
  deadline        DateTime       @db.Timestamptz(6)
  resolvedAt      DateTime?      @map("resolved_at") @db.Timestamptz(6)
  status          AlertStatus    @default(OPEN)

  review          SecurityReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  assignedTo      User           @relation("FindingAssignee", fields: [assignedToId], references: [id])

  @@map("security_findings")
}

model RiskRegister {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  description    String
  likelihood     RiskLikelihood @default(MEDIUM)
  impact         RiskImpact     @default(MODERATE)
  riskScore      Int            @default(9) @map("risk_score") // Likelihood (1-5) * Impact (1-5)
  status         RiskStatus     @default(IDENTIFIED)
  mitigationPlan String         @map("mitigation_plan")
  ownerId        String         @map("owner_id") @db.Uuid
  targetDate     DateTime       @map("target_date") @db.Timestamptz(6)
  residualScore  Int?           @map("residual_score")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner          User           @relation("RiskOwner", fields: [ownerId], references: [id])

  @@index([status])
  @@index([riskScore(sort: Desc)])
  @@map("risk_registers")
}

model SecurityIncident {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceNumber    String           @unique @map("reference_number") // e.g. "INC-2026-001"
  title              String
  category           String           // UNAUTHORIZED_ACCESS, DATA_LEAK, ACCOUNT_TAKEOVER
  severity           IncidentSeverity @default(P2_HIGH)
  status             IncidentStatus   @default(REPORTED)
  description        String
  containment        String?
  rootCause          String?          @map("root_cause")
  leadInvestigatorId String?          @map("lead_investigator_id") @db.Uuid
  reportedAt         DateTime         @default(now()) @map("reported_at") @db.Timestamptz(6)
  resolvedAt         DateTime?        @map("resolved_at") @db.Timestamptz(6)

  leadInvestigator   User?            @relation("IncidentLead", fields: [leadInvestigatorId], references: [id])

  @@index([status])
  @@index([severity])
  @@map("security_incidents")
}

model ChangeRequest {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  category      String              // INFRASTRUCTURE, DATABASE, SECURITY_CONFIG
  riskLevel     ChangeRiskLevel     @default(MEDIUM) @map("risk_level")
  reason        String
  planDetails   String              @map("plan_details")
  rollbackPlan  String              @map("rollback_plan")
  status        ChangeRequestStatus @default(SUBMITTED)
  requesterId   String              @map("requester_id") @db.Uuid
  approvedById  String?             @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?           @map("approved_at") @db.Timestamptz(6)
  implementedAt DateTime?           @map("implemented_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  requester     User                @relation("ChangeRequester", fields: [requesterId], references: [id])
  approvedBy    User?               @relation("ChangeApprover", fields: [approvedById], references: [id])

  @@index([status])
  @@map("change_requests")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blocker   User     @relation("BlockerUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("user_blocks")
}
