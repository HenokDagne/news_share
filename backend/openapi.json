  "info": {
    "title": "News Share API",
    "description": "News Share REST API documentation",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "in": "header"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "example": "S3cure-pass!"
          },
          "username": {
            "type": "string",
            "example": "ada_l",
            "description": "3-20 characters: letters, numbers, underscore"
          },
          "fullName": {
            "type": "string",
            "example": "Ada Lovelace"
          }
        },
        "required": [
          "email",
          "password",
          "username"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "example": "S3cure-pass!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "9f2c..."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "username": {
            "type": "string",
            "example": "ada_l"
          },
          "fullName": {
            "type": "string",
            "example": "Ada Lovelace",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "example": "Mathematician",
            "nullable": true
          },
          "avatarUrl": {
            "type": "string",
            "example": "https://res.cloudinary.com/demo/image/upload/v1/news_share/avatars/uid.jpg",
            "nullable": true
          },
          "followersCount": {
            "type": "number",
            "example": 12
          },
          "followingCount": {
            "type": "number",
            "example": 7
          },
          "email": {
            "type": "string",
            "example": "ada@example.com"
          }
        },
        "required": [
          "id",
          "username",
          "followersCount",
          "followingCount",
          "email"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "ada_lovelace",
            "description": "3-20 letters, digits or underscores"
          },
          "fullName": {
            "type": "string",
            "example": "Ada Lovelace"
          },
          "bio": {
            "type": "string",
            "example": "Mathematician and writer"
          }
        }
      },
      "ProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "username": {
            "type": "string",
            "example": "ada_l"
          },
          "fullName": {
            "type": "string",
            "example": "Ada Lovelace",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "example": "Mathematician",
            "nullable": true
          },
          "avatarUrl": {
            "type": "string",
            "example": "https://res.cloudinary.com/demo/image/upload/v1/news_share/avatars/uid.jpg",
            "nullable": true
          },
          "followersCount": {
            "type": "number",
            "example": 12
          },
          "followingCount": {
            "type": "number",
            "example": 7
          }
        },
        "required": [
          "id",
          "username",
          "followersCount",
          "followingCount"
        ]
      },
      "CreatePostDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Breaking News",
            "maxLength": 150
          },
          "content": {
            "type": "string",
            "example": "This is the article content...",
            "maxLength": 5000
          }
        }
      },
      "AuthorResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "username": {
            "type": "string",
            "example": "ada_l"
          },
          "fullName": {
            "type": "string",
            "example": "Ada Lovelace",
            "nullable": true
          },
          "avatarUrl": {
            "type": "string",
            "example": "https://res.cloudinary.com/demo/image/upload/v1/news_share/avatars/uid.jpg",
            "nullable": true
          }
        },
        "required": [
          "id",
          "username"
        ]
      },
      "PostResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "title": {
            "type": "string",
            "example": "Headline",
            "nullable": true
          },
          "content": {
            "type": "string",
            "example": "Story text...",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "example": "https://res.cloudinary.com/demo/image/upload/v1/news_share/posts/uid/abc.jpg",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "example": "2026-11-18T10:00:00.000Z"
          },
          "author": {
            "$ref": "#/components/schemas/AuthorResponseDto"
          }
        },
        "required": [
          "id",
          "createdAt",
          "author"
        ]
      },
      "UpdatePostDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Updated Headline",
            "maxLength": 150
          },
          "content": {
            "type": "string",
            "example": "Updated content...",
            "maxLength": 5000
          }
        }
      },
      "NotificationResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "type": {
            "type": "string",
            "example": "new_post",
            "enum": [
              "follow",
              "new_post"
            ]
          },
          "message": {
            "type": "string",
            "example": "A user you follow posted something new!",
            "nullable": true
          },
          "isRead": {
            "type": "boolean",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "example": "2026-11-18T10:00:00.000Z"
          },
          "postId": {
            "type": "string",
            "example": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
            "nullable": true
          },
          "actor": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/AuthorResponseDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "type",
          "isRead",
          "createdAt"
        ]
      }
    }
  }
}